{
  "title": "LLM Cost, Quality & Sessions",
  "description": "Generated by `signoz init`. Cost comes from gen_ai.usage.cost_usd (computed from token counts and .signoz/python/pricing.yaml — no hardcoded pricing). Groundedness and session rollups come from gen_ai.response.groundedness and session.id, the RAG-quality signals the app emits that auto-instrumentation cannot.",
  "version": "v5",
  "tags": ["signoz-init", "llm", "genai", "cost", "rag"],
  "variables": {},
  "layout": [
    { "i": "total-cost", "x": 0, "y": 0, "w": 3, "h": 3, "moved": false, "static": false },
    { "i": "total-tokens", "x": 3, "y": 0, "w": 3, "h": 3, "moved": false, "static": false },
    { "i": "llm-calls", "x": 6, "y": 0, "w": 3, "h": 3, "moved": false, "static": false },
    { "i": "avg-groundedness", "x": 9, "y": 0, "w": 3, "h": 3, "moved": false, "static": false },
    { "i": "cost-over-time", "x": 0, "y": 3, "w": 8, "h": 6, "moved": false, "static": false },
    { "i": "p95-latency", "x": 8, "y": 3, "w": 4, "h": 6, "moved": false, "static": false },
    { "i": "cost-by-model", "x": 0, "y": 9, "w": 6, "h": 6, "moved": false, "static": false },
    { "i": "tokens-by-model", "x": 6, "y": 9, "w": 6, "h": 6, "moved": false, "static": false },
    { "i": "cost-by-service", "x": 0, "y": 15, "w": 6, "h": 6, "moved": false, "static": false },
    { "i": "vector-latency", "x": 6, "y": 15, "w": 6, "h": 6, "moved": false, "static": false },
    { "i": "cost-by-session", "x": 0, "y": 21, "w": 6, "h": 6, "moved": false, "static": false },
    { "i": "groundedness-over-time", "x": 6, "y": 21, "w": 6, "h": 6, "moved": false, "static": false }
  ],
  "widgets": [
    {
      "id": "total-cost",
      "title": "Total LLM Cost",
      "description": "Sum of gen_ai.usage.cost_usd across all model calls.",
      "panelTypes": "value",
      "timePreferance": "GLOBAL_TIME",
      "yAxisUnit": "currencyUSD",
      "query": {
        "queryType": "builder",
        "builder": {
          "queryData": [
            {
              "dataSource": "traces",
              "queryName": "A",
              "expression": "A",
              "aggregations": [{ "expression": "sum(gen_ai.usage.cost_usd)" }],
              "filter": { "expression": "has(gen_ai.usage.cost_usd)" },
              "groupBy": [],
              "disabled": false
            }
          ],
          "queryFormulas": []
        }
      }
    },
    {
      "id": "total-tokens",
      "title": "Total Tokens",
      "description": "Input plus output tokens across every LLM call.",
      "panelTypes": "value",
      "timePreferance": "GLOBAL_TIME",
      "yAxisUnit": "short",
      "query": {
        "queryType": "builder",
        "builder": {
          "queryData": [
            {
              "dataSource": "traces",
              "queryName": "A",
              "expression": "A",
              "aggregations": [{ "expression": "sum(gen_ai.usage.input_tokens)" }],
              "filter": { "expression": "has(gen_ai.usage.input_tokens)" },
              "groupBy": [],
              "disabled": true
            },
            {
              "dataSource": "traces",
              "queryName": "B",
              "expression": "B",
              "aggregations": [{ "expression": "sum(gen_ai.usage.output_tokens)" }],
              "filter": { "expression": "has(gen_ai.usage.output_tokens)" },
              "groupBy": [],
              "disabled": true
            }
          ],
          "queryFormulas": [{ "queryName": "F1", "expression": "A + B" }]
        }
      }
    },
    {
      "id": "llm-calls",
      "title": "LLM Calls",
      "description": "Number of model invocations.",
      "panelTypes": "value",
      "timePreferance": "GLOBAL_TIME",
      "yAxisUnit": "short",
      "query": {
        "queryType": "builder",
        "builder": {
          "queryData": [
            {
              "dataSource": "traces",
              "queryName": "A",
              "expression": "A",
              "aggregations": [{ "expression": "count()" }],
              "filter": { "expression": "has(gen_ai.request.model)" },
              "groupBy": [],
              "disabled": false
            }
          ],
          "queryFormulas": []
        }
      }
    },
    {
      "id": "p95-latency",
      "title": "LLM p95 Latency",
      "description": "95th percentile duration of model calls. Latency spikes are one of the three symptoms in the 'Flying Blind' problem.",
      "panelTypes": "value",
      "timePreferance": "GLOBAL_TIME",
      "yAxisUnit": "ns",
      "query": {
        "queryType": "builder",
        "builder": {
          "queryData": [
            {
              "dataSource": "traces",
              "queryName": "A",
              "expression": "A",
              "aggregations": [{ "expression": "p95(duration_nano)" }],
              "filter": { "expression": "has(gen_ai.request.model)" },
              "groupBy": [],
              "disabled": false
            }
          ],
          "queryFormulas": []
        }
      }
    },
    {
      "id": "cost-over-time",
      "title": "Cost Over Time",
      "description": "Spend rate. A step change here is what a runaway agent looks like.",
      "panelTypes": "graph",
      "timePreferance": "GLOBAL_TIME",
      "yAxisUnit": "currencyUSD",
      "query": {
        "queryType": "builder",
        "builder": {
          "queryData": [
            {
              "dataSource": "traces",
              "queryName": "A",
              "expression": "A",
              "aggregations": [{ "expression": "sum(gen_ai.usage.cost_usd)" }],
              "filter": { "expression": "has(gen_ai.usage.cost_usd)" },
              "groupBy": [{ "key": "gen_ai.request.model", "type": "tag" }],
              "disabled": false
            }
          ],
          "queryFormulas": []
        }
      }
    },
    {
      "id": "cost-by-model",
      "title": "Cost by Model",
      "description": "Which model is actually driving spend.",
      "panelTypes": "bar",
      "timePreferance": "GLOBAL_TIME",
      "yAxisUnit": "currencyUSD",
      "query": {
        "queryType": "builder",
        "builder": {
          "queryData": [
            {
              "dataSource": "traces",
              "queryName": "A",
              "expression": "A",
              "aggregations": [{ "expression": "sum(gen_ai.usage.cost_usd)" }],
              "filter": { "expression": "has(gen_ai.usage.cost_usd)" },
              "groupBy": [{ "key": "gen_ai.request.model", "type": "tag" }],
              "orderBy": [{ "columnName": "#SIGNOZ_VALUE", "order": "desc" }],
              "disabled": false
            }
          ],
          "queryFormulas": []
        }
      }
    },
    {
      "id": "tokens-by-model",
      "title": "Input vs Output Tokens by Model",
      "description": "Output tokens usually cost several times more than input tokens, so the ratio matters as much as the total.",
      "panelTypes": "bar",
      "timePreferance": "GLOBAL_TIME",
      "yAxisUnit": "short",
      "query": {
        "queryType": "builder",
        "builder": {
          "queryData": [
            {
              "dataSource": "traces",
              "queryName": "A",
              "expression": "A",
              "aggregations": [{ "expression": "sum(gen_ai.usage.input_tokens)" }],
              "filter": { "expression": "has(gen_ai.usage.input_tokens)" },
              "groupBy": [{ "key": "gen_ai.request.model", "type": "tag" }],
              "legend": "input",
              "disabled": false
            },
            {
              "dataSource": "traces",
              "queryName": "B",
              "expression": "B",
              "aggregations": [{ "expression": "sum(gen_ai.usage.output_tokens)" }],
              "filter": { "expression": "has(gen_ai.usage.output_tokens)" },
              "groupBy": [{ "key": "gen_ai.request.model", "type": "tag" }],
              "legend": "output",
              "disabled": false
            }
          ],
          "queryFormulas": []
        }
      }
    },
    {
      "id": "cost-by-service",
      "title": "Cost by Service",
      "description": "Attributes spend to the service that made the call — the question 'which team is burning the budget' in dashboard form.",
      "panelTypes": "bar",
      "timePreferance": "GLOBAL_TIME",
      "yAxisUnit": "currencyUSD",
      "query": {
        "queryType": "builder",
        "builder": {
          "queryData": [
            {
              "dataSource": "traces",
              "queryName": "A",
              "expression": "A",
              "aggregations": [{ "expression": "sum(gen_ai.usage.cost_usd)" }],
              "filter": { "expression": "has(gen_ai.usage.cost_usd)" },
              "groupBy": [{ "key": "service.name", "type": "resource" }],
              "orderBy": [{ "columnName": "#SIGNOZ_VALUE", "order": "desc" }],
              "disabled": false
            }
          ],
          "queryFormulas": []
        }
      }
    },
    {
      "id": "vector-latency",
      "title": "Vector Search p95 Latency",
      "description": "Retrieval latency in the RAG path. A slow vector store looks identical to a slow model from the outside, which is exactly why both need to be on one screen.",
      "panelTypes": "graph",
      "timePreferance": "GLOBAL_TIME",
      "yAxisUnit": "ns",
      "query": {
        "queryType": "builder",
        "builder": {
          "queryData": [
            {
              "dataSource": "traces",
              "queryName": "A",
              "expression": "A",
              "aggregations": [{ "expression": "p95(duration_nano)" }],
              "filter": { "expression": "name IN ('qdrant.search', 'qdrant.query', 'chroma.query', 'pinecone.query', 'weaviate.query')" },
              "groupBy": [{ "key": "name", "type": "tag" }],
              "disabled": false
            }
          ],
          "queryFormulas": []
        }
      }
    },
    {
      "id": "avg-groundedness",
      "title": "Avg Groundedness",
      "description": "Mean of gen_ai.response.groundedness (0–1): how much of each answer came from the retrieved context. A drop here is an early hallucination signal — the 'agent hallucinates in production' symptom, made measurable.",
      "panelTypes": "value",
      "timePreferance": "GLOBAL_TIME",
      "yAxisUnit": "none",
      "query": {
        "queryType": "builder",
        "builder": {
          "queryData": [
            {
              "dataSource": "traces",
              "queryName": "A",
              "expression": "A",
              "aggregations": [{ "expression": "avg(gen_ai.response.groundedness)" }],
              "filter": { "expression": "has(gen_ai.response.groundedness)" },
              "groupBy": [],
              "disabled": false
            }
          ],
          "queryFormulas": []
        }
      }
    },
    {
      "id": "cost-by-session",
      "title": "Cost by Conversation",
      "description": "Total spend grouped by session.id — 'which conversation cost the most', not just which model. This is the rollup that turns per-call cost into a per-user budget.",
      "panelTypes": "bar",
      "timePreferance": "GLOBAL_TIME",
      "yAxisUnit": "currencyUSD",
      "query": {
        "queryType": "builder",
        "builder": {
          "queryData": [
            {
              "dataSource": "traces",
              "queryName": "A",
              "expression": "A",
              "aggregations": [{ "expression": "sum(gen_ai.usage.cost_usd)" }],
              "filter": { "expression": "has(gen_ai.usage.cost_usd) AND has(session.id)" },
              "groupBy": [{ "key": "session.id", "type": "tag" }],
              "orderBy": [{ "columnName": "#SIGNOZ_VALUE", "order": "desc" }],
              "disabled": false
            }
          ],
          "queryFormulas": []
        }
      }
    },
    {
      "id": "groundedness-over-time",
      "title": "Groundedness Over Time",
      "description": "Answer groundedness trended over time. A sustained dip is a regression in retrieval or prompting — the kind of quality drift that is invisible in cost and latency alone.",
      "panelTypes": "graph",
      "timePreferance": "GLOBAL_TIME",
      "yAxisUnit": "none",
      "query": {
        "queryType": "builder",
        "builder": {
          "queryData": [
            {
              "dataSource": "traces",
              "queryName": "A",
              "expression": "A",
              "aggregations": [{ "expression": "avg(gen_ai.response.groundedness)" }],
              "filter": { "expression": "has(gen_ai.response.groundedness)" },
              "groupBy": [{ "key": "service.name", "type": "resource" }],
              "disabled": false
            }
          ],
          "queryFormulas": []
        }
      }
    }
  ]
}
